<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>renode-ingest</AssemblyName>
    <RootNamespace>RenodeIngest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Locator finds and loads the SDK's own MSBuild at runtime; do not add
         Microsoft.Build package references, which shadow it (and carry an
         unfixed advisory). Verified working without them. -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.11.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

</Project>
