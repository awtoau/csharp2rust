# Machine-specific paths to external trees. See .env.example.
.env

# Scratch and logs.
tmp/

# Agent worktrees. These are separate git checkouts; `git add -A` otherwise
# stages them as embedded repositories and the path check then walks into a
# directory it cannot read.
.claude/

# Rust
target/
Cargo.lock

# .NET (the Roslyn frontend)
bin/
obj/

# Python
__pycache__/
*.pyc
.venv/

# Baseline boot archives: large logs, regenerable via scripts/baseline_boot.py
tmp/baseline/

# Rust spike build output
spike/*/target/

# Corpus database: regenerable via frontend/RenodeIngest (10 MB, changes every run).
# UNANCHORED (`**/`) deliberately: these patterns were anchored to the top-level
# rulesdb/ only, and the ingest resolves its output path relative to the CURRENT
# DIRECTORY -- so running it from frontend/RenodeIngest created a second corpus
# there whose -shm and -wal were committed and pushed.
**/rulesdb/*.db
**/rulesdb/*.db-wal
**/rulesdb/*.db-shm
