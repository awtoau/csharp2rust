# Copy to .env (gitignored) and set for your machine.
#
# This repo contains NO absolute paths in tracked files -- see
# scripts/check_paths.py. External trees are located through these variables;
# this repo's own root is resolved with `git rev-parse --show-toplevel`.

# Renode source checkout (tag v1.17.0 or later, built from source so that C#
# compilation errors in `include @Foo.cs` are actually reported).
RENODE_SRC=/path/to/renode

# Shared Renode git store (see docs/tools/source-stores.md equivalent in
# awto-dan). `scripts/sync_renode.py --tag vX.Y.Z` adds a worktree off this
# store under tmp/renode-vX.Y.Z and points RENODE_SRC at it -- never clone
# Renode directly, never set RENODE_SRC into the store itself.
# RENODE_STORE=/path/to/git_mirror/renode

# The target STM32F427 firmware repo, used as the boot payload and as the
# source of the CLI test suite the oracle drives.
FIRMWARE_SRC=/path/to/firmware

# Shared awto agent rules and Codex brief assembler. Optional when awto-dan is
# checked out beside this repository.
AWTO_DAN=/path/to/awto-dan

# Optional: prebuilt firmware ELF. Defaults to a build under $FIRMWARE_SRC.
# FIRMWARE_ELF=/path/to/firmware.elf
